local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local localPlayer = Players.LocalPlayer

local ADMINS = {
 = true,
}

if not ADMINS[localPlayer.UserId] then return end

local AdminRemote = ReplicatedStorage:WaitForChild("AdminRemoteAction")

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "AdminControlPanel"
screenGui.ResetOnSpawn = false
screenGui.Parent = localPlayer:WaitForChild("PlayerGui")

local mainFrame = Instance.new("Frame")
mainFrame.Size = UDim2.new(0, 220, 0, 360)
mainFrame.Position = UDim2.new(0, 20, 0.5, -180)
mainFrame.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
mainFrame.BorderSizePixel = 0
mainFrame.Active = true
mainFrame.Draggable = true
mainFrame.Parent = screenGui

local titleLabel = Instance.new("TextLabel")
titleLabel.Size = UDim2.new(1, 0, 0, 35)
titleLabel.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
titleLabel.Text = "BLOBMAN ADMIN ADVANCED"
titleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
titleLabel.TextSize = 13
titleLabel.Font = Enum.Font.SourceSansBold
titleLabel.Parent = mainFrame

local nameTextBox = Instance.new("TextBox")
nameTextBox.Size = UDim2.new(0, 180, 0, 30)
nameTextBox.Position = UDim2.new(0.5, -90, 0, 45)
nameTextBox.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
nameTextBox.Text = ""
nameTextBox.PlaceholderText = "Nhập tên người chơi..."
nameTextBox.TextColor3 = Color3.fromRGB(255, 255, 255)
nameTextBox.TextSize = 14
nameTextBox.Font = Enum.Font.SourceSans
nameTextBox.Parent = mainFrame

local function createButton(text, position, color, callback)
	local button = Instance.new("TextButton")
	button.Size = UDim2.new(0, 180, 0, 30)
	button.Position = position
	button.BackgroundColor3 = color
	button.Text = text
	button.TextColor3 = Color3.fromRGB(255, 255, 255)
	button.TextSize = 13
	button.Font = Enum.Font.SourceSansBold
	button.BorderSizePixel = 0
	button.MouseButton1Click:Connect(callback)
	button.Parent = mainFrame
	return button
end

