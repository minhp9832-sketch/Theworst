	local btnFlingSelf = makeButton("BtnFlingSelf", 56, "Fling Self (Bounce)")
	local btnSpawnThing = makeButton("BtnSpawnThing", 92, "Spawn Thing")
	local btnFlingThing = makeButton("BtnFlingThing", 128, "Fling Nearest Thing")

	frame.Size = UDim2.new(0, 240, 0, 168)

	gui.Parent = localPlayer:WaitForChild("PlayerGui")

	local horizSpeedSelf = 2600
	local upSpeedSelf = 2100

	local horizSpeedThing = 3200
	local upSpeedThing = 1700

	local function CallServer(action: string, data: table)
		UNC_RemoteEvent:FireServer(action, data)
	end

	local function PressFlingSelf()
		local look = GetLookDirection()
		CallServer("FlingSelf", {
			LookDirection = look,
			HorizontalSpeed = horizSpeedSelf,
			UpwardSpeed = upSpeedSelf,
		})
	end

	local function PressSpawnThing()
		local pos = GetSafeSpawnPosition()
		local look = GetLookDirection()
		CallServer("SpawnFlingThing", {
			SpawnPosition = pos,
			LookDirection = look,
			HorizontalSpeed = horizSpeedThing,
			UpwardSpeed = upSpeedThing,
		})
	end

	local function PressFlingNearestThing()
		local look = GetLookDirection()
		CallServer("FlingNearestThing", {
			LookDirection = look,
			HorizontalSpeed = horizSpeedThing,
			UpwardSpeed = upSpeedThing,
		})
	end

	btnFlingSelf.MouseButton1Down:Connect(function()
		PressFlingSelf()
	end)

	btnSpawnThing.MouseButton1Down:Connect(function()
		PressSpawnThing()
	end)

	btnFlingThing.MouseButton1Down:Connect(function()
		PressFlingNearestThing()
	end)

	local UIS = game:GetService("UserInputService")
	UIS.InputBegan:Connect(function(input: InputObject, gameProcessed: boolean)
		if gameProcessed then
			return
		end
		if input.UserInputType == Enum.UserInputType.Keyboard then
			if input.KeyCode == Enum.KeyCode.J then
				PressFlingSelf()
			elseif input.KeyCode == Enum.KeyCode.K then
				PressSpawnThing()
			elseif input.KeyCode == Enum.KeyCode.L then
				PressFlingNearestThing()
			end
		end
	end)

	local function RefreshStatus()
		local root = GetCharacterRoot()
		if root then
			status.Text = "Local: Self + Your Things"
		else
			status.Text = "Waiting for character..."
		end
	end

	localPlayer.CharacterAdded:Connect(function()
		task.wait(0.2)
		RefreshStatus()
	end)

	RefreshStatus()
end
