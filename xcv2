local function getGuiParent()
    local ok2, cg = pcall(function() return game:GetService("CoreGui") end)
    if ok2 and cg then return cg end
    return LocalPlayer:WaitForChild("PlayerGui")
end

local function makeNameESP(plr)
    if plr == LocalPlayer then return end
    task.spawn(function()
        local char = plr.Character or plr.CharacterAdded:Wait()
        local hrp = char:WaitForChild("HumanoidRootPart", 5)
        if not hrp then return end
        if hrp:FindFirstChild("XOCUNameESP") then return end
        local bb = Instance.new("BillboardGui")
        bb.Name = "XOCUNameESP"
        bb.Adornee = hrp
        bb.Size = UDim2.new(0, 180, 0, 30)
        bb.StudsOffset = Vector3.new(0, 3, 0)
        bb.AlwaysOnTop = true
        bb.Parent = getGuiParent()
        local txt = Instance.new("TextLabel")
        txt.Size = UDim2.new(1, 0, 1, 0)
        txt.BackgroundTransparency = 1
        txt.TextScaled = true
        txt.TextColor3 = Color3.fromRGB(255, 220, 120)
        txt.TextStrokeTransparency = 0
        txt.Font = Enum.Font.SourceSansBold
        txt.Text = plr.DisplayName
        txt.Parent = bb
    end)
end

local function removeNameESP(plr)
    local char = plr.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp and hrp:FindFirstChild("XOCUNameESP") then
            hrp.XOCUNameESP:Destroy()
        end
    end
end

VisualGroup:CreateToggle({
    Name = "Player Name ESP", Flag = "NameESP", Default = false,
    Callback = function(v)
        if v then
            for _, p in ipairs(Players:GetPlayers()) do makeNameESP(p) end
            Players.PlayerAdded:Connect(makeNameESP)
        else
            for _, p in ipairs(Players:GetPlayers()) do removeNameESP(p) end
        end
    end,
})

