    Callback = function(v)
        State.PacketSpamActive = v
        if not v then return end
        task.spawn(function()
            local rate = State.PacketRate or 3
            local size = State.PayloadSize or 8
            while State.PacketSpamActive do
                local payload = buildNoisePayload(size)
                for _ = 1, rate do
                    pcall(function()
                        if DestroyGrabLine then DestroyGrabLine:FireServer(payload) end
                        if CreateGrabLine then CreateGrabLine:FireServer(payload, payload) end
                    end)
                end
                RunService.Heartbeat:Wait()
            end
        end)
    end,
})
