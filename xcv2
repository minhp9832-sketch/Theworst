local function startUnifiedAntiGrab()
    if State.AntiGrabActive then return end
    if not BeingHeld or not StruggleRemote then
        notify("XOCU", "Anti Grab unavailable (missing remote)", 4)
        return
    end
    State.AntiGrabActive = true

    local anchorPos = nil
    local anchorFrames = 0

    local function onHeldChanged()
        local hrp = getHRP(LocalPlayer)
        if not hrp then return end
        if BeingHeld.Value then
            anchorPos = hrp.CFrame
            anchorFrames = 30
        end
    end

    if State.AntiGrabUnifiedConn then State.AntiGrabUnifiedConn:Disconnect() end
    if State.AntiGrabHeldConn then State.AntiGrabHeldConn:Disconnect() end

    State.AntiGrabHeldConn = BeingHeld.Changed:Connect(onHeldChanged)

    State.AntiGrabUnifiedConn = RunService.Heartbeat:Connect(function()
        if not State.AntiGrabActive then return end
        local char = getChar(LocalPlayer)
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum or hum.Health <= 0 then return end

        if BeingHeld.Value then
            pcall(function() StruggleRemote:FireServer(LocalPlayer) end)
            if RagdollRemote then
                pcall(function() RagdollRemote:FireServer(hrp, 0) end)
            end
            if GameCorrections then
                local stop = GameCorrections:FindFirstChild("StopAllVelocity")
                if stop then pcall(function() stop:FireServer() end) end
            end
            hum.Sit = false
            pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)

            if anchorFrames > 0 and anchorPos then
                hrp.CFrame = anchorPos
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero
                anchorFrames = anchorFrames - 1
            end
        else
            anchorFrames = 0
        end
    end)
end

local function stopUnifiedAntiGrab()
    State.AntiGrabActive = false
    if State.AntiGrabUnifiedConn then State.AntiGrabUnifiedConn:Disconnect() State.AntiGrabUnifiedConn = nil end
    if State.AntiGrabHeldConn then State.AntiGrabHeldConn:Disconnect() State.AntiGrabHeldConn = nil end
    local hrp = getHRP(LocalPlayer)
    if hrp then hrp.Anchored = false end
end

