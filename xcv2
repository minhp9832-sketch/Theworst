    Callback = function(v) State.BlobFlySpeed = v end,
})

BlobFlyGroup:CreateToggle({
    Name = "Blob Fly (WASD)",
    Flag = "BlobFly",
    Default = false,
    Callback = function(v)
        State.BlobFlyActive = v
        if not v then
            if State.BlobFlyBV then State.BlobFlyBV:Destroy() end
            if State.BlobFlyBG then State.BlobFlyBG:Destroy() end
            State.BlobFlyBV = nil
            State.BlobFlyBG = nil
            return
        end
        task.spawn(function()
            while State.BlobFlyActive do
                local root = getBlobHRP()
                if root then
                    if not State.BlobFlyBV or not State.BlobFlyBV.Parent then
                        State.BlobFlyBV = Instance.new("BodyVelocity")
                        State.BlobFlyBV.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                        State.BlobFlyBV.P = 1e5
                        State.BlobFlyBV.Parent = root
                    end
                    if not State.BlobFlyBG or not State.BlobFlyBG.Parent then
                        State.BlobFlyBG = Instance.new("BodyGyro")
                        State.BlobFlyBG.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
                        State.BlobFlyBG.P = 2e4
                        State.BlobFlyBG.D = 100
                        State.BlobFlyBG.Parent = root
                    end
                    local dir = Vector3.zero
                    if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + Camera.CFrame.LookVector end
                    if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir - Camera.CFrame.LookVector end
                    if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir = dir - Camera.CFrame.RightVector end
                    if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + Camera.CFrame.RightVector end
                    if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0,1,0) end
                    if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then dir = dir - Vector3.new(0,1,0) end
                    State.BlobFlyBV.Velocity = dir * State.BlobFlySpeed
                    State.BlobFlyBG.CFrame = Camera.CFrame
                end
                RunService.Heartbeat:Wait()
            end
        end)
    end,
})

local function blobKickLoop()
    while State.BlobKickActive do
        local target = State.SelectedPlayer
        local tHRP = getTargetHRP()
        local myHum = getHum(LocalPlayer)
        if not target or not target.Parent or not tHRP or not myHum then
            RunService.Heartbeat:Wait()
        else
            local seat = myHum.SeatPart
            if not seat or not seat.Parent or seat.Parent.Name ~= "CreatureBlobman" then
                RunService.Heartbeat:Wait()
            else
                local blob = seat.Parent
                local remoteFolder = blob:FindFirstChild("BlobmanSeatAndOwnerScript")
                if not remoteFolder then RunService.Heartbeat:Wait() else
                    local grab = remoteFolder:FindFirstChild("CreatureGrab")
                    local drop = remoteFolder:FindFirstChild("CreatureDrop")
                    local LDet = blob:FindFirstChild("LeftDetector")
                    local RDet = blob:FindFirstChild("RightDetector")
                    local LW = LDet and (LDet:FindFirstChild("LeftWeld") or LDet:FindFirstChild("RigidConstraint"))
                    local RW = RDet and (RDet:FindFirstChild("RightWeld") or RDet:FindFirstChild("RigidConstraint"))

                    if grab and drop and LDet and RDet and LW and RW then
                        pcall(function()
                            grab:FireServer(LDet, tHRP, LW)
                            grab:FireServer(RDet, tHRP, RW)
                            drop:FireServer(LW, tHRP)
                            drop:FireServer(RW, tHRP)
                        end)
                        claimOwnership(tHRP)
                        tHRP.AssemblyLinearVelocity = Vector3.new(0, 500, 0)
                    end
                    RunService.Heartbeat:Wait()
                end
            end
        end
    end
end

