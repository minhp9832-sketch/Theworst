local function getChar(plr) return plr and plr.Character end
local function getHRP(plr)
    local c = getChar(plr)
    return c and c:FindFirstChild("HumanoidRootPart")
end
local function getHum(plr)
    local c = getChar(plr)
    return c and c:FindFirstChildOfClass("Humanoid")
end
local function isAlive(plr)
    local h = getHum(plr)
    return h and h.Health > 0
end
local function isNetworkOwnerOf(part)
    if not part then return false end
    local po = part:FindFirstChild("PartOwner")
    return po and po.Value == LocalPlayer.Name
end
local function claimOwnership(part)
    if not part or not part.Parent or not SetNetOwner then return end
    pcall(function() SetNetOwner:FireServer(part, part.CFrame) end)
end
local function getMyToysFolder()
    return Workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
end

local function spawnToy(toyName, cframe, velocity, timeout)
    timeout = timeout or 3
    if not SpawnToyRemote then return nil end
    local folder = getMyToysFolder()
    if not folder then return nil end
    if CanSpawnToy and not CanSpawnToy.Value then
        pcall(function() CanSpawnToy.Changed:Wait() end)
    end
    local spawned
    local conn
    conn = folder.ChildAdded:Connect(function(child)
        if child.Name == toyName then spawned = child end
    end)
    pcall(function()
        SpawnToyRemote:InvokeServer(toyName, cframe, velocity or Vector3.new(0,0,0))
    end)
    local t0 = tick()
    repeat task.wait() until spawned or (tick() - t0 > timeout)
    if conn then conn:Disconnect() end
    return spawned
end

local function getTargetHRP()
