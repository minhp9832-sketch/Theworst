local function loopGrabLoop()
    local myChar = getChar(LocalPlayer)
    local myHRP  = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHRP then return end
    local savedPos = myHRP.CFrame

    while State.LoopGrabActive do
        local target = State.SelectedPlayer
        local tHRP = getTargetHRP()
        if not target or not target.Parent or not tHRP then
            RunService.Heartbeat:Wait()
        else
            local att = tHRP:FindFirstChild("XOCULock")
            if not att then
                att = Instance.new("Attachment")
                att.Name = "XOCULock"
                att.Parent = tHRP
            end
            local holder = myHRP:FindFirstChild("XOCUHolder")
            if not holder then
                holder = Instance.new("Attachment")
                holder.Name = "XOCUHolder"
                holder.Parent = myHRP
            end
            if not tHRP:FindFirstChild("XOCUAlign") then
                local ap = Instance.new("AlignPosition")
                ap.Name = "XOCUAlign"
                ap.Attachment0 = att
                ap.Attachment1 = holder
                ap.MaxForce = math.huge
                ap.Responsiveness = 60
                ap.Parent = tHRP
                local ao = Instance.new("AlignOrientation")
                ao.Name = "XOCUAlignOri"
                ao.Attachment0 = att
                ao.Attachment1 = holder
                ao.MaxTorque = math.huge
                ao.Responsiveness = 60
                ao.Parent = tHRP
            end

            holder.Position = Vector3.new(0, 12, 0)
            claimOwnership(tHRP)
            if DestroyGrabLine then pcall(function() DestroyGrabLine:FireServer(tHRP) end) end
            if RagdollRemote then pcall(function() RagdollRemote:FireServer(tHRP, 0) end) end
            RunService.Heartbeat:Wait()
        end
    end

    local target = State.SelectedPlayer
    if target then
        local tHRP = getHRP(target)
        if tHRP then
            for _, name in ipairs({"XOCUAlign", "XOCUAlignOri", "XOCULock"}) do
                local o = tHRP:FindFirstChild(name)
                if o then o:Destroy() end
            end
        end
    end
    if myHRP then
        myHRP.CFrame = savedPos
        local h = myHRP:FindFirstChild("XOCUHolder")
        if h then h:Destroy() end
    end
end

