            if DestroyGrabLine then pcall(function() DestroyGrabLine:FireServer(tHRP) end) end
            if RagdollRemote then pcall(function() RagdollRemote:FireServer(tHRP, 0) end) end

            tHRP.CFrame = CFrame.new(tHRP.Position.X, tHRP.Position.Y + 800, tHRP.Position.Z)
