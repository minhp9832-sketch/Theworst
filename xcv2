local function buildNoisePayload(sizeKB)
    local chars = {}
    for i = 1, 32 do chars[i] = string.char(math.random(33, 126)) end
    local base = table.concat(chars)
    return string.rep(base, math.max(1, math.floor((sizeKB * 1024) / 32)))
end

