local function getBlob()
    local folder = getMyToysFolder()
    return folder and folder:FindFirstChild("CreatureBlobman")
end

local function findNearestBlob()
    local myHRP = getHRP(LocalPlayer)
    if not myHRP then return nil end
    local best, bestDist = nil, 50
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and obj.Name == "CreatureBlobman" then
            local root = obj:FindFirstChild("HumanoidRootPart") or obj.PrimaryPart
            if root then
                local d = (root.Position - myHRP.Position).Magnitude
                if d < bestDist then
                    bestDist = d
                    best = obj
                end
            end
        end
    end
    return best
end

local function sitBlob()
    local hum = getHum(LocalPlayer)
    local hrp = getHRP(LocalPlayer)
    if not hum or not hrp or hum.SeatPart then return end

    local blob = findNearestBlob()
    if not blob then
        blob = spawnToy("CreatureBlobman", hrp.CFrame * CFrame.new(0, 5, 5))
    end
    if not blob then return end

    local seat = blob:FindFirstChildWhichIsA("VehicleSeat", true)
              or blob:FindFirstChildWhichIsA("Seat", true)
    if not seat then return end

    hrp.CFrame = seat.CFrame + Vector3.new(0, 2, 0)
    task.wait(0.03)
    seat:Sit(hum)
end

